//#pragma save_binary

#include <mudlib.h>

inherit ROOM;

void create()
{
	::create();
    set_short("微風路");
	set_long( @C_LONG_DESCRIPTION
你現在正走在微風路上。廣場位於你的東方不遠處，微風路向西
一路延伸下去，北邊的建築物是本鎮的法院。
C_LONG_DESCRIPTION
	);

	set_outside( "farwind" );
	set( "light", 1 );
	set( "exits", ([
		"west" : "/d/noden/farwind/wbazz",
		"north" : "/d/noden/farwind/courthouse",
		"east" : "/d/noden/farwind/square"
	]) );
#include <replace_room.h>
}
