#include "../saulin_temple.h"

inherit MONSTER;

void create()
{
        ::create();
        set_level(14);
        set_name( "fire monk", "火工頭陀" );
        add ("id", ({ "monk" }) );
        set_short("火工頭陀");
        set("unit","位");
        set_long(@C_LONG
你看到一位長的滿臉橫肉，叫人一看了就討厭的人，他本來要投入少林當
和尚，可是因為品性不佳，沒人肯幫他剃度，所以在少林作一些燒火打柴
的粗活，因為帶髮修行，所以他自稱火工頭陀。
看來他剃度修行是假，偷學武功是真，他一定是偷經書(book)的人了。
C_LONG
        );
        set( "inquiry", ([
             "book" : "@@ask_book"  ]));

        set("alignment",-1200);
        set("wealth/silver",200);
        set_perm_stat("str", 20);
        set_perm_stat("dex", 22);
        set_skill("parry",80);
        set_skill("dodge",80);
	set_skill("unarmed",100);
        set_natural_weapon(20, 19, 25);
        set_natural_armor(70, 30);
        set("max_hp", 600);
        set("hit_points", 600);
        set("max_fp", 1800);
        set("force_points", 1800);
	set("force_effect",2);
        set("special_defense", ([ "all" : 25, "none" : 10 ]) );
        set("aim_difficulty", ([ "critical" : 20, "vascular" : 10,]) );
        set("gender", "male");
        set("race", "human");
        set_c_verbs(({ "%s施展大力金剛指向%s戳去", "%s用金剛掌拍向%s",
                       "%s用鐵頭功一頭向%s撞去" }));
}

void ask_book(object player)
{
    tell_object( this_player(), @ALONG
         火工頭陀臉上一陣痙攣，邪笑道：
         你發現了老子的秘密，還想活著走出這裡嗎？
         
ALONG
                );
    kill_ob( player );
}

void die()
{
    object killer;

    killer = query("last_attacker");
    killer->set_temp("book_quest/step",2);
    tell_object(killer,@DIE
    
  「啊 ～～～ 我不要死，你饒了我吧!!」
  
火工頭陀倒在地上口吐鮮血，眼見是不行了! 你突然心有不忍，
於是便替他急救，保住了他一命。

  「謝謝你 ! 但是我真的沒有偷經書!! 我知道了狐狸的秘密以後，就常常
    來這裡看書，但我從來不敢也沒有必要把書帶走，書真的不是我偷的!!」

你想想，一本在空中飄的書的確逃不過守衛的眼睛，於是你決定將火工頭
陀綁在這裡，然後去向方丈大師報告(report)詳細的情形。

DIE
    );
    remove();
}
