#include "../mad.h"
#include <ansi.h>
#include <stats.h>
#include <conditions.h>

inherit MONSTER;

void create()
{
        ::create();
        set_level(19);
        set_name( "elder Guo", "郭長老" );
        add ("id", ({ "elder", "guo" }) );
        set_short( "郭長老" );
        set("unit","位");
        set_long(@C_LONG
你看到一位白鬚垂胸, 面色略顯嚴肅的高瘦老者。相傳他曾於三十六歲時,
不騰挪半步, 獨自靜坐於大海旁危□之上, 達七晝夜之久, 而最後終於頓悟
出江湖中人人渴求敬畏的『怒潮三曲』。且三十年前, 郭長老為了搭救至友
刑老爹, 於牧馬關外一役, 憑著一把玉簫, 獨力殲滅追殺之敵數百人!
C_LONG
        );
        set("alignment",1200);
        set("wealth/copper",100);
        set("gender","male");
        set("race","human");
        set("tactic_func","special_attack");
        set("hit_points",850);
        set("force_points",2500);
        set("max_hp",850);
        set("max_fp",2500);
        set_perm_stat("str",25);
        set_perm_stat("dex",30);
        set_perm_stat("pie",30);
        set_perm_stat("kar",24);
        set_perm_stat("con",22);
        set_perm_stat("int",28);
        set_natural_weapon(30, 12, 28);
        set_natural_armor(100,50);
   set( "special_defense", ([ "all": 60, "none": 20 ]) );
        set( "aim_difficulty",([ "weakest":25,"vascular":30,"ganglion":20 ]) );
        set( "stun_difficulty",50 );
        set_skill("dodge",100);
        set_skill("shortblade",100);
        set_skill("parry",100);
        set_skill("inner-force",100);
        wield_weapon( IANOBJ"flute" );
        set("inquiry", ([
          "hsin" : "老刑!?老夫甚久未與他碰面了.....\n"
                   "聽說他隱居於西方的大陸之中, 還收了不少徒子徒孫!\n",
          "burglar" : @C_LONG
約莫半年之前, 本村突現一採花賊, 辣手摧殘無辜
少女, 於是許多有閨女之人家紛紛遷離此處, 以致本村凋敝若今
。而當老夫奮力追查其蹤時, 惡賊竟聞風而逃, 銷聲□跡! 此後
, 老夫遍尋四方, 盼能捕捉並手刃此賊。不意, 此賊竟又回至此
處! 老夫由幽國城日夜兼程趕回, 宵旰巡查--可嘆仍然一無所獲
。或許小張曾發現其蹤(trace),您去問問他吧。
C_LONG
        ]) );
}

void init()
{
   npc::init();
   add_action( "inform_me", "inform" );
}

int inform_me(string arg)
{
   object hero;

   hero = this_player();

   if( !arg || ( arg!="elder" && arg!="guo" ) )
        return notify_fail( "你要通知誰啊?\n" );
   if( (int)hero->query_quest_level("iywolf")<1 ) {
        if( !hero->query_temp("kill_ian_devil") )
        return notify_fail( "郭長老搖頭道: 去! 去! 老夫沒空聽你說書...\n" );
        tell_object( hero, @OK
郭長老嘆道: 原來淫魔竟是桂老的化身! 無怪乎小梅在小張
之羽翼下仍遭毒手 ........
感謝大俠您為本村及世上除去一大害。老夫代表本村致十萬
分之謝意, 並奉上一點薄禮, 望您笑訥。

[ 郭長老翻箱倒櫃找出一袋錢幣交給你 ]
[ 你完成了『煙雨村之狼』的任務, 得到八千點經驗值 ]
OK
        );
   if( (string)hero->query("class")=="adventurer"
     && (int)hero->query_level()> 4 )
   tell_object( hero,
        "噢！差點忘了！大俠您可以去找小張教您某個技巧(skill)。\n" );
        hero->finish_quest("iywolf",1);
        hero->gain_experience(8000);
        hero->credit("copper",5000);
        return 1;
   }
   write(
"郭長老微笑道: 大俠, 您的作為, 老夫深感敬佩,\n"
"但本村地小人窮, 實在沒有多餘的錢給您了。\n" );

   return 1;
}

int special_attack()
{
   object *victim, *weapon1, *weapon2;
   int i, num;
    
   victim = (object *)this_object()->query_attackers();
   weapon1 = victim->query("weapon1");
   weapon2 = victim->query("weapon2");
   num = sizeof(victim);

   if( !victim || random(20)<15 ) return 0;

   if( num == 2 ) {
     tell_room( environment(this_object()),
        "\n郭長老開始吹奏『怒潮三曲』之『驚濤駭浪』........\n\n"
        "一種無形的聲浪襲向你的身體!!\n\n",
     this_object() );
     (CONDITION_PREFIX + "confused")->apply_effect( victim[1], 6, 10 );
     (CONDITION_PREFIX + "confused")->apply_effect( victim[0], 6, 10 );
     victim[1]->block_attack(10);
     victim[0]->block_attack(10);
     victim[1]->set_temp("msg_stop_attack", 
        "( 你被一種無形的聲浪困住, 無法攻擊！ )\n" );
     victim[0]->set_temp("msg_stop_attack", 
        "( 你被一種無形的聲浪困住, 無法攻擊！ )\n" );
     return 1;
     }

   if( num == 3 ) {
     tell_room( environment(this_object()),
        "\n郭長老開始吹奏『怒潮三曲』之『推波助瀾』........\n\n"
        "你們竟不自主地攻擊同伴!!\n\n" );
     victim[1]->cease_all_attacks();
     victim[2]->cease_all_attacks();
     victim[0]->cease_all_attacks();
     victim[1]->kill_ob(victim[2]);
     victim[2]->kill_ob(victim[0]);
     victim[0]->kill_ob(victim[1]);
     return 1;
     }

   if( num > 3 ) {
    for( i=0; i<sizeof(victim); i++ ) {
     tell_object( victim[i],
        "\n郭長老開始吹奏『怒潮三曲』之『排山倒海』........\n\n"
        "你們被一陣音浪衝撞, 武器脫手, 飛出屋外!!\n\n" );
     if( victim[i]->query("weapon2") ) {
        weapon2[i]->unwield();
        weapon2[i]->move(environment(this_object()));
        victim[i]->calc_weapon_class();
        weapon1[i]->unwield();
        weapon1[i]->move(environment(this_object()));
        victim[i]->calc_weapon_class();
        }
     if( !victim[i]->query("weapon2") && victim[i]->query("weapon1") ) {
        weapon1[i]->unwield();
        weapon1[i]->move(environment(this_object()));
        victim[i]->calc_weapon_class();
        }
     }
    for( i=0; i<sizeof(victim); i++ ) {
        victim[i]->receive_special_damage("energy",100);
        victim[i]->move_player(IAN"hamlet_path2",
                   "你被震出屋外!\n", "一團黑影從北方的屋中摔出!\n" );
        }
    return 1;
   }
   return 1;
}

int accept_item(object who,object item)
{
   if( item->id("corpse") ) {
     tell_room( environment(this_object()),
        "郭長老道: 老夫雖然酷愛收藏物品, 但□體還是免了!\n"
        "[ 郭長老說著說著就把"+item->query("c_name")+"丟在地上! ]\n"
        , this_object() );
     item->move(environment(this_object()));
     return 1;
     }
   tell_room( environment(this_object()),
        "郭長老道: 多謝! 老夫最喜愛收藏物品!\n"
        "[ 郭長老說著說著就把"+item->query("c_name")+"收了起來! ]\n"
        , this_object() );
   item->remove();
   return 1;
}
