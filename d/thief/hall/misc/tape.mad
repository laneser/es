// Created by Aquarius@EasternStory
#include <mudlib.h>
inherit OBJECT;
int be_stick ;

void create()
{
     be_stick = 0;
     seteuid(getuid());
     set_name("scotch tape","特製膠帶");
     add("id",({"tape"}));
     set("short","@@query_short");
     set_long(@LONG
一卷特製膠帶, 黏性超強, 遇水不脫落, 貼不緊退錢。 
使用方法 : stick tape on <something>." 
LONG );
     set( "unit", "卷");
     set("weight",1);
     set("value", ({ 40, "silver" }));
//     set("amount",1);
}

string query_short()
{
    if ( be_stick == 0 ) {
    	return "特製膠帶";
    } else {
	if ( this_player() == environment(this_object()) ) 
		return "一卷貼在你嘴上的特製膠帶";
	else
		return sprintf("一卷貼在%s嘴上的特製膠帶",environment(this_object())->query("c_name")) ;
    }	
}

void init()
{
	if ( be_stick ) {
		add_action("do_tear","tear");
		add_action("do_say","say");
		add_action("do_say","shout");
//	add_action("do_cast","cast");
		add_action("do_say","whisper");
		add_action("do_say","knight");
		add_action("do_say","monk");
		add_action("do_say","scholar");
		add_action("do_say","adv");
		add_action("do_say","mage");
		add_action("do_say","healer");
		add_action("do_say","tell");
		add_action("do_say","es");
		add_action("do_say","chat");
		add_action("do_say","songin");
	} else if ( userp(this_player()) ){
		add_action("do_put","stick");
	}
}

int do_say(string arg)
{
	if ( ! be_stick ) return 0;
	write("你的大嘴巴被膠帶(tape)貼住了, 先把膠帶撕(tear)下來吧。\n");
	tell_room(environment(previous_object()),sprintf("%s支支吾吾的不知道在說什麼。\n",previous_object()->query("c_name")),previous_object());
	return 1;
}

int do_tear(string arg)
{
	if ( ! id(arg) ) return 0;
	write("你撕下膠帶。\n");
	tell_room(environment(this_player()),this_player()->query("c_name")+"撕下膠帶。\n",this_player());
	this_player()->delete_temp("silence");
	return this_object()->remove();
}

int npc_do_tear(object me)
{
	tell_room(environment(me),me->query("c_name")+"撕下膠帶。\n");
	me->delete_temp("silence");
	return this_object()->remove();
}

int do_put(string arg)
{
	object env,dest,me;
	int skill,succeed;
	string name,ob_name;
	if( be_stick==1 ) return notify_fail("這膠帶已經在使用中了。\n");
	if ( sscanf(arg,"%s on %s",ob_name,name) != 2 ) return 0;
	if ( ! id( ob_name ) ) return notify_fail("貼什麼 ?\n");
	me = this_player();
	env = environment(me);
	dest = present(name,env);
	if ( me->query_current_attacker() ) {
		return notify_fail("你正忙著戰鬥, 哪有空貼膠帶呢?\n");
	}
	if ( ! dest ) return notify_fail(name+"不在這邊。\n");
	if ( ! living(dest) ) {
		write("你用膠帶把"+dest->query("c_name")+"貼的密不通風。\n");
		tell_room(env,sprintf("%s拿著膠布, 將%s胡亂貼一通。\n",me->query("c_name"),dest->query("c_name") ),({me}));
		this_object()->remove();
		return 1;
	}
/* 	since player 被貼不會互 k, we don't have to check that ..
	if ( (int) me->query_level() < 5 ) {
		return notify_fail("你的等級太低了, 最好不要亂貼...\n");
	}
*/
	if ( userp(dest) && (int)dest->query_level() < 5 ) {
		return notify_fail("請不要欺負弱小..\n");
	}

	if ( dest == me ) {
		tell_room(env,sprintf("%s用膠帶把自己的嘴巴貼起來。\n",me->query("c_name")),me);
		write("你用膠帶貼住自己的嘴巴。\n");
		be_stick = 1;
		this_object()->move(dest);
		this_object()->set("extra_look", "$N的大嘴巴上不知道被誰貼了膠帶。\n");
		this_object()->set("prevent_drop",1);
		this_object()->set("prevent_insert",1);
		this_object()->set("long","這條膠帶貼住你的嘴巴, 快把它撕掉吧!(tear tape)\n");
		return 1;
	}

	// max value of skill : lv 19 vs. lv 1 => 160 ( 19+24+18+100)
	skill = (int) me->query_stat("int")-(int) dest->query_stat("int");
	skill += (int) me->query_stat("kar")-(int) dest->query_stat("kar");
	skill -= (int) dest->query_level();
	skill += (int)me->query_skill("trick");
	succeed = ( skill > random(110) );

	write("你帶著純真無邪的笑容, 對著"+dest->query("c_name")+"笑一笑..\n");
	tell_room(env,me->query("c_name")+"帶著純真無邪的笑容, 對著"+
		dest->query("c_name")+"笑一笑...\n",({me,dest}));
	tell_object(dest,me->query("c_name")+"帶著純真無邪的笑容, 對你笑一笑..\n");

	if ( dest->query("no_attack") ) 
		return notify_fail( dest->query("c_name")+"對你笑一笑說道 : 小朋友, 這樣不可以喔!\n");

	
	if ( succeed ) {
		write(sprintf("%s對著你愉快地笑著。\n",dest->query("c_name")));
		tell_room(env,sprintf("%s對著%s愉快的地微笑著。\n",dest->query("c_name"),me->query("c_name")),({dest,me}));
		tell_object(dest,sprintf("你對著%s愉快地笑著。\n",me->query("c_name")));
		be_stick = 1;
		tell_room(env, set_color(sprintf("\n突然%s以迅雷不急掩耳的速度掏出一卷膠帶,二話不說貼向%s!!\n",me->query("c_name"),dest->query("c_name")),"HIY"),({me,dest}));
		write(set_color("\n你以迅雷不急掩耳的速度掏出一卷膠帶,二話不說貼向"+dest->query("c_name")+"\n","HIY"),me);
		tell_object(dest,set_color("\n"+me->query("c_name")+"以迅雷不急掩耳的速度掏出一卷膠帶,二話不說貼在你嘴上!!\n","HIY"));

		this_object()->move(dest);
		this_object()->set("extra_look", "$N的大嘴巴上不知道被誰貼了膠帶。\n");
		this_object()->set("prevent_drop",1);
		this_object()->set("prevent_insert",1);
//		this_object()->set("short","一條正貼在某人嘴巴上的膠帶");
		this_object()->set("long","這條膠帶貼住你的嘴巴, 快把它撕掉吧!(tear tape)\n");
		if ( ! userp(dest) ) {
			me->kill_ob(dest);
			dest->kill_ob(me);
		}
		dest->block_attack( (skill > 60 ? 4 : 2) );
		dest->set_temp("msg_stop_attack",
			"( 你急著撕掉膠帶, 沒辦法出手 ! )\n");
		dest->set_temp("silence");
		if ( ! userp(dest) )  // npc 自動撕掉, player 自己手動撕吧 !
//			call_out("npc_do_tear",6,dest );
			call_out("npc_do_tear",4 + skill/20 ,dest );
	} else {
	    if ( ! userp(dest) ) {
		tell_room(env,sprintf("%s突然大喝一聲: 搞這種雕蟲小技, 去死吧 !!\n",dest->query("c_name"),me->query("c_name")),({me,dest}));
		write(sprintf("%s突然大喝一聲: 搞這種雕蟲小技, 去死吧 !!\n",dest->query("c_name")));
		tell_object(dest,sprintf("你發現%s對你不懷好意, 於是發動攻擊。\n",me->query("c_name")));
		me->kill_ob(dest);
		dest->kill_ob(me);
		me->set_temp("msg_stop_attack","( 你一陣手忙腳亂, 沒辦法出手! )\n");
		me->block_attack( 2 );
	   } else {
		write( sprintf("你的企圖被識破了,%s對你笑一笑說道 : 小朋友, 這樣不可以喔!\n",dest->query("c_name")) );
		tell_object(dest, sprintf("%s似乎有什麼企圖。\n",me->query("c_name")) );
	   }
	}
	return 1;
}

