#include "farwind.h"
#include <money.h>

inherit ROOM;
inherit "/std/seller";
inherit DOORS;

void create()
{
        ::create() ;
        set("light", 1) ;
   set_short( "遠風書店" );
   set_long(
@LONG
這裡是遠風鎮唯一的書店，也是整個諾頓大陸上最大的書店。
當你一走了進來，你感到一股書香的氣息。你左手(left)邊的書架
上擺了一排的小說，右手(right )邊則是一些古典文學類的書。而
擺在櫃檯(table )上的，是一些最近的暢銷書籍。
LONG
       );
        
        set( "exits", ([ 
        	"south" : FARWIND"bazz2" ,
        ]) );
        
        set_inventory( ({
                       ({ "/d/noden/farwind/items/story1.c",10,10}),
                       ({ "/d/noden/farwind/items/story2.c",10,10}),
		       ({ "/d/noden/farwind/items/pie_book1.c",10,10}),			
        }) );
        create_door("south","north",
		 ([  "keyword" : ({"wooden","door"}),
		     "name"    : "wooden door",
		     "c_name"  : "木門",
		     "c_desc"  : "這是一扇可愛的小木門，門上掛了一個書店的招牌",		
		     "status"  : "open",
		]) );
	set("c_item_desc",([
		"left" : 
@C_DESC1
你看到書架上擺了這些書：
-----------------------------------
紙飛機天堂(story1)	10 silvers
失敗唐璜(story2)	10 silvers
-----------------------------------
C_DESC1

		,"table" : 
"你隨手翻著櫃檯上的書，突然一套書吸引了你的目光\n"
"———————————————————————\n"
"自己動手做系列１\n"
"1) 如何做派（蘋果篇）(pie_book1)    20 silvers \n"
"2) 如何做派（草莓篇）(pie_book2)    40 silvers \n"
"3) 如何做派（櫻桃篇）(pie_book3)    40 silvers\n"
"——————————————————————— \n"
"蘋果篇已出版，草莓及櫻桃請稍後...\n"
"———————————————————————\n"
		,"right" : 
"你看到書架上空空如也，什麼都沒有...\n"
		])	);		 	
        set( "objects", ([
                "shop owner" : "/d/noden/farwind/monster/book_owner",
        ]) );
        reset();
}

void reset()
{
	room::reset();
	seller::reset();
}
