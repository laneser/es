ob_data (["c_short.text":"ES BUGS 留言板","id":({"board","bulletin board",}),"c_long":"@@query_c_long","short.text":"ES bugs board","c_long.text":"這是一個留言板，專供人報告 BUGS 。詳細用法請參看 help board。由於 ES 是屬於大家的，因此希望任何人都在此報告所發現的 BUGS 。","last_location":0,"silent_look":1,"cap_name":"Board","c_name":"留言板","long.text":"This is a bulletin board. For information on how to use it, use `help board'.","c_cap_name":"留言板","name":"board","short":"@@query_short","c_short":"@@query_c_short","long":"@@query_long",])
messages ({(["poster":"Deltree","time":889493503,"body":"真是可憐mnb說得動聽，但卻不見人來搞sigh不知他的大計何時可以兌現chat* shake mnbchat* kick mnb","title":"< no title >","id":1587,]),(["poster":"Mnb","time":889502052,"title":"22 to 正在搞","body":"wait time.okok?","id":1588,]),(["poster":"Snow","time":889583170,"body":"發信到這裡snow發信到這裡 snow@nease.net寫上姓名,聯繫辦法,編程經驗,玩MUD經歷,巫師經驗","title":"to 相當wiz的player","id":1589,]),(["poster":"Love","time":889674660,"title":"to snow","body":"姓名：黑龍(long)聯繫辦法：finger long編程經驗：以什麼為標準？玩MUD經歷：不到半年，什麼也不懂巫師經驗：0，       想在這裡做巫師看看，拿點巫師經驗，grin等以後到其他地方，也可以騙個巫師做做laugh","id":1590,]),(["poster":"Love","time":889685237,"title":"< no title >","body":"啊哈！你似乎覺得有點不對勁！有什麼不對勁的?mnb,我老婆在西遊記已經和別人結婚了，你也不用到stmud去劈她了sighcry可憐以後少玩mud為妙在家裡很悶呀","id":1591,]),(["poster":"Oser","time":889772869,"body":"姓名：oser聯繫辦法：call oser編輯經驗：在學當巫師經驗：沒有想法和long一樣grin","title":"to snow","id":1592,]),(["poster":"Deltree","time":889816788,"title":"< no title >","body":"我也想做wizard!玩mud經驗：玩過4，5個mudwizard經驗：和long一樣，但對c語言有一定水平chat* grin","id":1594,]),(["poster":"Mnb","time":889851784,"title":"28 to all","body":"神仙島，巫國城，丐幫。。。都開啦！大量秘密，大量勁npc和裝備等你去。加油啊，大家！只能透露說：在海微港附近。。。grin","id":1595,]),(["poster":"Idol","time":889938958,"body":"□藍天□現在沒人.","title":"< no title >","id":1596,]),(["poster":"Idol","time":890002841,"body":"cast ltn on farmer你不記得有這種法術。幻雷術(Lightning) [0] 怎麼回事？wiz,help me","title":"< no title >","id":1597,]),(["poster":"Idol","time":890079876,"body":"kick moon,上來了也不看信，help me","title":"< no title >","id":1598,]),(["poster":"Sage","time":890269388,"title":"to player","body":"hi 大家好！","id":1599,]),(["poster":"Deltree","time":890333384,"body":"well come sage希望你的到來會力我們帶來驚喜努力。為player服務chat* addoil sage","title":"< no title >","id":1600,]),(["poster":"Sage","time":890342807,"title":"< no title >","body":"hi!謝謝deltree的鼓勵我第一次做巫師，所以對這一行業不是很熟,有不周之處請多原諒為了大家能在es玩得更開心，現在本人要求徵稿內容：semote請大家積極投稿，我會很感激你們的","id":1601,]),(["poster":"Sage","time":890348307,"title":"< no title >","body":"hi,由於沒有人投稿,所以到現在只加了兩個semote.分別是love,caxie在這裡感謝hellfire給我投的第一個稿","id":1603,]),(["poster":"Paul","time":890416906,"body":"姓名： 狂風舞(paul)聯繫辦法：打我家電話或call 我編程經驗：努力學習中玩MUD經歷：好象有1年了吧，都玩過3，4個了。巫師經驗：0 too,不給機會我，那來的經驗？","title":"to snow","id":1604,]),(["poster":"Moon","time":890419243,"body":"鑑於Snow 過忙, 由Moon代理申請巫師的事務:發信到: qwerty@starplace.com寫上真實姓名,聯繫辦法,編程經驗,玩MUD經歷,巫師經驗                      Moon","title":"想當巫師的player","id":1606,]),(["poster":"Patric","time":890425480,"body":"newmail沒有提示，要是加上就好了。","title":"好象newmail沒有提示。","id":1608,]),(["poster":"Nu","time":890448681,"title":"< no title >","body":"連進來的ip也不能改好!cry請moon把我進來的ip!改兩個!gent and intel!不然上帝不讓我用intel 連上mud!thanks!","id":1609,]),(["poster":"Nu","time":890450502,"title":"< no title >","body":"sorry moon 我搞好了!","id":1610,]),})
