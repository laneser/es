#d/wiz/wiz_board.c
ob_data (["long":"@@query_long","short.text":"巫師留言板","short":"@@query_short","name":"board","c_cap_name":"留言板","long.text":"這是一個留言板，專供人留言紀事。詳細用法請參看 help board。這個留言板雖然是屬於巫師公會的，但任何人都歡迎在這裡留言。","id":({"board","bulletin board",}),"c_name":"留言板","silent_look":1,])
messages ({(["locked":"elon","id":55,"body":"    五月二十日會議記錄    出席人員: Annihilator , Elon , Ruby , Iris , Aquarius ,              Ega , Redheart , Indra    討論提綱       1 . 更換 driver : 前一次更換driver 後crash 三次, 原因均為                         griffon , 推測是mount.c 有問題, 改寫                         mount.c 後更換driver.         2 . 武器等級 : 武器等級原本的建議表似乎並不受重視 . 有提案                      建議改行ES2 的weapon type 方式, 但因物品太多                      故無結果 .        3 . 由於記憶體接近飽和 , 故將來有新區域出現時, 將逐步關閉           部份舊區域 , 並修正 ES 之風格 .       4 . heart_beat() 改寫.以減低 cpu load       5 . 對於玩家指令 \"do\" 加以限制, 每個 heart heat 限為五個.           且scan 方式由 explode 改為 sscanf       6 . body 由object 改寫後置入 daemon .       7 . 檔案流出 : 據信其它MUD 有相當多的file 來自ES , 因為無法防範                      故請欲\"交流\"者先行知會一聲, 以免發生誤會。並請各                      位在寫檔案時記得於檔頭處簽上智慧財產權聲明.                      如 : // This file contains all gamble funcs                           //   By Indra@Eastern_Story  5.20.95       8 . 鑑於巫師日漸增多, 而產能並未跟著提高 , 故見習巫師升為正式巫師           後一段時間(一至三個月)若無作品, 將酌情予以暫時調降回見習巫師.       9 . 更換driver 後改寫lib , 整理 daemons .                                                        記錄 Indra.","title":"會議記錄","time":801083538,"poster":"Indra",]),(["locked":"elon","id":85,"title":"ES 5/27/95 Meeting","body":" 5/27/95 ES 會議記錄 (13:00 - 16:10)出席者: (ES) Indra, Iris, Elon, Lica        (插花的) Heal, Chanel特別感謝 Iris 請客..... :)  1. 三個月沒上線的玩家檔案要砍, 以節省 disk space...    -> Elon 寫指令砍檔 2. 夫妻 Party 有 bonus, 另一半上線會通知.    -> Indra 3. 種族, 公會屬性上限修改    -> Iris 4. Auction 抽成比例    -> Indra 5. 把四個大神的雕像放回去    -> Iris 6. 各種族的魔法防禦調為不高於 + - 50%    -> Iris 7. beholder 增加一項可以穿的 : amulet    -> Iris 8. 結婚的條件 (以上線時間或等級來限制)    -> Elon 9. 見習巫師升巫師時需經過 domain arch 及 Elon 面試通過.10. 特攻武器的特色及修改    -> 各 domain arch 負責, 細節請找 Iris, Indra or Elon 問.11. 巫師公會沒用的 board 要砍要整理.    -> Elon12. 特攻時的 block command 要改 (eg, Beholder gaze)    -> Indra13. 色狼協會的東東..    -> Elon & Lica14. 開放 Social Guild...  讓玩家申請設立.    -> Elon15. Party 分 exp 的公式 (改為 level 平方...)    -> Indra16. 新版 Rule ....    -> Elon (& Tsunami)17. Iris 的暑假作業... 詳情請問 Iris 各項標題的細節將由負責人各別提出討論... -Elon","time":801626200,"poster":"Elon",]),(["id":96,"title":"< no title >","body":"說道合理性的問題, 火把在水裡竟然能燒, 有沒有人想要改改這不合理的事實, 今天有人要修改種族與公會的屬性, 如果能夠增加大家玩的興趣, 那當然是無可厚非的, 但是值得注意的, 是新方案對大家的影響, 丹p果影響並不大, 那似忽有再斟酌的餘地不過話又說回來, 既然有人要作, 應該給些鼓勵才是, 不管我們大家贊不贊成新方案                        Sincerely Your Takeda","time":801713662,"poster":"Takeda",]),(["id":97,"title":"Re: ES 5/27/95 Meeting","body":"On Sun May 28, Elon wrote:>  5. 把四個大神的雕像放回去>     -> Iris.......................................................................1. 這四個雕像根本還沒修好(有些英文沒砍, 殺他們會得探險度也沒拿掉).2. 我不認為把他們放在那間國王的圖書館很適當(感覺怪怪的).3. 這四個雕像應該與系統無關吧? (當然他們四人有很大的貢獻)   因此, 要放之前或之後應該先和我討論吧?   (不想多說了, 希望大家能搞清楚啥是『授權』及『品質控制』)4. 建議取消雕像之類的東東, 建個『英雄館』之類的.   最好把Ruby, Elon的名字也放上去.5. 雕像被我(永久)拿掉了, 如果想放回去:     a. 給我個合理的解釋.     b. 等我不幹了.     c. 把諾頓的管理權收回(我樂得輕鬆, 大家亂得爽).        Sincerely your mad...","time":801715314,"poster":"Mad",]),(["id":98,"title":"武器的特殊攻擊","body":"現在的武器特殊攻擊型態大多很類似, 而且數量上已經到了□爛的程度, 沒有特攻的武器反而算特殊了我們那天討論的結果是原則上一個domain 內的特殊攻擊不能有兩把類似型態的,eg. drain mace, night dagger, black sword 都是類似    的形態, 請各domain arch 和各區域創作者協調, 想出更多更變態的特殊攻擊:p                                             Iris.","time":801716336,"poster":"Iris",]),(["id":99,"title":"關於種族特色...","body":"現有的種族我覺得也很有特色啊！EX：ORC攻擊力加倍，蜥蜴人AC乘3/2 ....就這兩種族練的騎士或MONK絕對會比其他種族強關於眼魔不是防魔法力特高嗎？弱只弱在他不能穿很多EQ吧！種族特色應該可由蠻多地方表現的..後天努力的修業應該也可彌補屬性吧！（EXP需要的多寡）當然若有心人想把種族弄得更有差異性的話...*SHRUG*只是要考慮未來的平衡問題太龐大了不要花了很多工夫了之後又遭到很多反對聲浪...那到時挫折感也會很大...just my  suggestion....					wiwi","time":801718047,"poster":"Wiwi",]),(["id":100,"title":"關於種族屬性的修改","body":"最新版的修改方式, 其總和未變(120), 如此已解決Ruby所提之大部份問題.但如果決定要做的話(很可能要砍玩家檔案), 希望能考慮下面幾件事:   a. 取消屬性總和受等級高低的限制.     (冒險者公會沒有額外的屬性點數, 但四級以上可由某NPC\"鍛練\"各屬性一點)   b. 決定是否要加上升級限制(依探險度及任務點數的高低).     (否則事實上還是無法消除玩家\"只會練功\\"的現象)     (e.g.1.有天我曾stat某人--探險度只有六點(ES現有1xx點探險度),             上線時間一天多, 但卻是屬性及技巧全滿之十九級:P)     (e.g.2.上週某天突然發現有個臺大的女孩在玩ES, 一問之下竟還是            十九級醫生, 但她跟我說她幾乎不解任務(約三個吧), 還跟            我說可以不經牛頭人(其實是牛頭人已被殺)就到席理斯*faint*)        Sincerely your mad...","time":801718755,"poster":"Mad",]),(["id":101,"title":"創作外流","body":"前幾天(上週吧)曾在此板上看到: 其它MUD(大概是EP吧)有甚多抄襲ES的作品.我想如果是參考如: look, go, get ..... 等系統之一般指令還無可厚非.但據正確之消息指出(EP之某大神當面對我說), 竟連\"蟻穴\"之全部coding,也被當做參考材料! 我想就消極面來說, 這應該已侵犯他人之智慧財產權;就積極面來說, 對於國內的MUD的成長反而有傷害.(畢竟\"抄襲\"不等於\"技術交流\")希望曾經或正要COPY ES中檔案與其它MUD的巫師, 能仔細想想是否適當?        Sincerely your mad...","time":801721930,"poster":"Mad",]),(["id":102,"title":"my opinion about race","body":"Hi! all  我反對採用類似4040 的種族屬性方式，最主要的原因是和4040 太像了，而且我也贊成Ega 所說的，表現種族特性不一定要由屬性表現。現在的種族的抗魔法能力不同，可以穿的有些有限制，有些有一些特殊能力，像elf 的隱形，orc 吃屍體，等等。而有些種族的特殊能力一直沒有做，為什麼我們不朝這方面繼續做呢？  另外我贊成Mad 的意見，把升級時也考慮explore ， 當然explore 也必須整個重考慮一次。Mad 已經把noden 大陸的explore 重設了。至於是否考慮quests, 精神我是贊成，但是我是覺得現有quests 大都要高等級才能解，而有些quests 某些職業很難完成，目前似乎還不太適合。                                              Yueh ","time":801730424,"poster":"Yueh",]),(["id":103,"title":"about knight's DB","body":"   Dear all:        knight's DB now have 限制,是不是故意的????                                 Sincerely Zeus","time":801732959,"poster":"Zeus",]),(["id":104,"title":"Re: about knight's DB","body":"On Mon May 29, Zeus wrote:>    Dear all:>         knight's DB now have 限制,是不是故意的????>                                  Sincerely Zeus             ??? every guild db have limit bah...not only knight..       go to check attack.c then u will know..","time":801734129,"poster":"Innocence",]),(["id":105,"title":"about eqs' speciial defense","body":"hi! all  Elsa 告訴我裝備的special_defense 設all 沒有作用，我看了一下code,發現code 沒有考慮讓巫師設all 。我不覺得這是bug , 而是一個裝備可以防所有魔法似乎很奇怪，因此我不希望去改這部分的程式。而是去改那些裝備，這樣好像很麻煩，但是我不希望因為方便而出現很多防所有魔法的裝備。現在有一些裝備有設all, 我看了一下，大部分是比較新的區域裡的裝備。當然這是我的意見，如果大家認為改穿裝備的code 比較方便，那就這樣改吧。  我只是告訴大家現在裝備的special_defense 設all 沒用，而就我的意見，我不太希望有防具能防所有魔法。                                          Yueh ps. 補充一下，如果一個防具增加防火系的防禦，就該設減弱防冰系的防禦才比較合理，如果一個防具可以增加防所有魔法的防禦，這個防具未免太好了，除非這防具的ac and db 非常非常差。","time":801738187,"poster":"Yueh",]),(["id":106,"body":"請問要讓怪物能執行thief 或scholar 的一些特殊技能,可否使用comman(\".....\"),若能, 要怎麼改, 謝謝...                 Sincerely Your Takeda","title":"< no title >","time":801744622,"poster":"Takeda",]),(["id":107,"title":"< no title >","body":"To all:	記得以前有人說過,island 還不算正式開放,所以我把我那個不搭嘎的	area 關掉了.......that's all			ishige","time":801830914,"poster":"Ishige",]),(["id":108,"body":"do the same as ishige...                       mercury","title":"< no title >","time":801842214,"poster":"Mercury",]),(["id":109,"body":"To all:     我也關掉了, 希望這樣記憶體的用量會少到不至於產生lag.    That's all.                                    Tsunnami","title":"< no title >","time":801842872,"poster":"Tsunami",]),(["id":110,"title":"< no title >","body":"嗯.....不知道發生啥事？現在寫區域亦定要有搭嘎？其他三個人都關了，我那也沒有啥價值唯一的戰爭也發動不了先關起來好了 沒殺檔案 要是嫌佔硬碟空間 請自便！反正那也只不過花我半個寒假的時間罷了！				Odin ...... ","time":801848451,"poster":"Odin",]),(["id":111,"body":"     我認為屬性是屬於一個人物先天的特質, 能夠達到     什麼境界, 絕大部份在出生時就已經決定了, 後天     的努力只能改變少部份, 雖然反對聲浪很大, 我還     是認為種族和加入公會都要對屬性有影響較合理,     而且種族的影響要比公會來的大。這兩天又想了一     個修正案, 請大家看一看, 有意見再討論....     如果能提出更好的idea, 那是最好不過了:)                                      Iris.","title":"屬性","time":801878726,"poster":"Iris",]),(["id":112,"body":"以下是目前在「東方故事」中你可以選擇扮演的種族，後面各項屬性值表示各種族所能到達的上限, 隨著所加入公會的不同, 會有一項對該公會最重要的屬性可以超過種族上限三, 但超過的部份要由其他屬性扣除, 若要更詳細的資料, 請用help <種族名稱>。------------------------------------------------------------------------種族                    力量    智慧    敏捷    體質    虔誠    運氣------------------------------------------------------------------------人類    (Human)          20      20      20      20      20      20精靈    (Elf)            17      23      22      18      20      20矮人    (Dwarf)          22      18      20      23      19      18半獸人  (Orc)            23      17      20      24      18      18地精    (Gnome)          18      18      20      20      24      20半身人  (Halfling)       18      18      24      18      18      24蜥蜴人  (Lizardman)      24      16      22      22      18      18妖精    (Imp)            15      24      23      15      23      20魔族    (Daemon)         21      21      21      21      18      18半人馬  (Centaur)        22      18      20      21      18      21黑暗精靈(Drow)           20      22      22      18      18      20眼魔    (Beholder)       14      26      16      20      24      20吸血鬼  (Vampire)        22      24      22      16      18      18鳥人    (Hawkman)        20      17      23      22      16      22變形蟲  (Shapeshifter)   20      20      20      20      20      20------------------------------------------------------------------------","title":"修正案","time":801878782,"poster":"Iris",]),(["id":113,"body":"一個beholder 屬性是         str    int     dex   con     pie     kar          14     26      16    20      24      20若他加入魔法師, 且mage 主要屬性 int他可以選擇 int 26-29 但他若將 int 練到 29, 就必需從其他屬性中扣除 3 點,我認為這樣可以讓player有更多的練法,不同的人有不同的屬性,玩法也可以更多樣化.                                        Iris","title":"example...","time":801879095,"poster":"Iris",]),(["id":114,"body":"On Wed May 31, Iris wrote:>      我認為屬性是屬於一個人物先天的特質, 能夠達到>      什麼境界, 絕大部份在出生時就已經決定了, 後天>      的努力只能改變少部份, 雖然反對聲浪很大, 我還>      是認為種族和加入公會都要對屬性有影響較合理,>      而且種族的影響要比公會來的大。這兩天又想了一>      個修正案, 請大家看一看, 有意見再討論....>      如果能提出更好的idea, 那是最好不過了:)> >                                       Iris.    我還是反對 ... 除非你能幫所有的 mob 也調調屬性 ...							茹比    真搞不懂為什麼一定要搬石頭來砸腳？	為了合理兩字嗎？在 Mud 裡談合理？	我只知道在合理的情況下，一個人不能扛著 100 多 kg 	還能打架打得很高興 ...","title":"Re: 屬性","time":801880584,"poster":"Ruby",]),(["id":115,"body":"On Wed May 31, Ruby wrote:> On Wed May 31, Iris wrote:> >      我認為屬性是屬於一個人物先天的特質, 能夠達到> >      什麼境界, 絕大部份在出生時就已經決定了, 後天> >      的努力只能改變少部份, 雖然反對聲浪很大, 我還> >      是認為種族和加入公會都要對屬性有影響較合理,> >      而且種族的影響要比公會來的大。這兩天又想了一> >      個修正案, 請大家看一看, 有意見再討論....> >      如果能提出更好的idea, 那是最好不過了:)> > > >                                       Iris.> >     我還是反對 ... 除非你能幫所有的 mob 也調調屬性 ...> > 							茹比> >     真搞不懂為什麼一定要搬石頭來砸腳？> > 	為了合理兩字嗎？在 Mud 裡談合理？> 	我只知道在合理的情況下，一個人不能扛著 100 多 kg > 	還能打架打得很高興 ...> 除了合理, 我還想讓ES有更多變化, 不是每個人都有一樣的屬性, 穿一樣的制服,這樣才會有更多的玩法, 更多的變化,                                         Iris","title":"Re: Re: 屬性","time":801882007,"poster":"Iris",]),(["id":116,"body":"昨天有人用ET控制碼讓所有見到他的人跳出倚天,mail 給他警告後, 回信如下:        你說我用et控制瑪,喔,是嗎? 是沒錯,只不過,玩顏色的人不也是用et控制碼嗎?□名字的人,不也是嗎?        其實et控制碼真的不合理,我有辦法用et控制碼把es所有用et的人的電腦都用當,        只是我不做而已,跟你說這個只是想說這個東西是有點不合理,或許該改吧,並非        是我想炫耀我有多厲害..提供一些意見供你參考...                                        大壞人   何必孤毒                                                       coo所以我把控制碼關掉了....                                        Iris.","title":"chfn中加入限制用ET控制碼","time":801886543,"poster":"Iris",]),(["id":117,"title":"optimized some commands","body":"Optimized \"who\" command, eval cost from 4xxxx to 3xxxx (2xxxx sometimes :P)And \"look\" command, eval cost from 1xxxx to 7xxx.						- Annihilator","time":801894421,"poster":"Annihilator",]),(["id":118,"body":"Commented out 2 sort_array in \"who\" command, this improves \"who\"command's eval cost from 32000 to 25000.						- AnnihilatorPS. If can optimize query(\"name\"), can improve more.","title":"Optimized \"who\" further more","time":801911801,"poster":"Annihilator",]),(["id":119,"body":"Optimized \"inventory\" command a bit by changing a looped string additionto implode().							- Annihilator","title":"Optimzed \"inventory\" a bit.","time":801913362,"poster":"Annihilator",]),(["id":120,"title":"no-match setup??","body":"    just find a no-match setup between description & setup in races    in description it say mental spell hard affect lizardman    but in setup it set mental -50 in lizardman...so strange..    is it  wrong or..?..    plz check it...","time":801920391,"poster":"Innocence",]),(["id":121,"body":"剛剛和嶽聊了一下，說了些有關殺檔案和關區域的原因說了一堆灰色的沒有建設性的東東（當然是我說的）其實剛剛在聊的時候，tsunami & ishige 在我旁邊，有些話是替他們說的而他們火氣正旺，有些很衝，我還是照原意表達了現在要說說我自己的一些看法其實那天上線，看他們殺檔案，我也滿驚訝的，而我們的小島有些事件是有關連的所以我當然跟進，因為整個區域都支離破碎了，留著還有啥意思我本身是不太贊成殺檔這種作法的，有點激烈，而且不會有啥正面效果，或許表達了一些抗議的意味（我自己是沒殺檔啦）做巫師有一段時間了，我想我是被歸類在沒有啥貢獻CODE功力又不行的那類，可我也有話要說ES現在常常有一些「討論」，常常是觀念的差異，當雙方有意見不和時通常的結果是，真正能動手，且有動手去做的人，他的觀念得以實行可是，問題是出在，有些CODE一動就","title":"一些想法！","time":801943031,"poster":"Odin",]),(["id":122,"body":"sorry 工作站掛了 沒有中文可看 所以一斷一斷POST剛剛說道 有些CODE是會影響到全部的或許是一個公會 或許是一個種族 甚或是全部的玩家那是不是相關的都要動過？可大部份的CODE都不是自己寫的，要動不是很累？或許原本CODE的還在 現在問題來了 你的想法關係到別人的想法甚或是你的構想與他人相沖突，這下變成你強迫他人要做調整或許你只是堅持你自己的想法，可是由別人的立場來看，你可能已經是，超過建議或者溝通的範圍，而變成另一種不尊重他人想法的表現尤其是有上下級之分的時候，一句「不行」，或者是「要不然你來做」就變成嚴重具有命令或惡意的話或許你說，這是有這麼嚴重嗎？ 嗯！ 好像是沒有可是給人的感覺很差！ 或許你做了很多事！ 或許你很累！但是你也要去想人家怎麼想，你也許會說那太累了？！我要說的是，今天扛這大頭銜的是你，你也要多些責任上面的人有管理的責任 這也是為何你比較偉大的原因其實MUDDING大家都是自願的，大家也都是有心的就像tsunami 他雖然說不管事了 可還是跑到我寢室 吵著我上線有較大職權的管理者 是有較大的權力 但是你要試管到大家都不歡而散那不是很可惜嗎？！ 尤其是象我們的CASE 大家其實都是沒有「義務」的MUDDING意願是我們的出發點，所以特別要在意別人的觀點，否則人家就一走了之，你也沒辦法！說時在玩MUD，除了有「玩」到以外，所得的就是相互相屬之道，我想大家都還是很珍惜這緣份的，不是嗎？屁了很多，又沒版面， 辛苦你了！！","title":"續","time":801944693,"poster":"Odin",]),(["id":123,"body":"再灌！！ CODE的人還在！第十七行 試管---> 是管第二十一行 相互相處！","title":"訂正！","time":801944993,"poster":"Odin",]),})
