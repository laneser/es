#include "almuhara.h"

inherit ROOM;

void create()
{
	::create();
	set_short("地下甬道");
	set_long( 
@C_LONG_DESCRIPTION
這兒是一個長長的甬道，你可以看到前方隱約傳來的亮光。一陣陣的風從前方吹來，
你想大概快到了吧.......
C_LONG_DESCRIPTION
	);

	set( "exits", ([ 
		"north" : TOMB"/room5", 
		"south" : TOMB"/room1",  ]) );
	set( "objects", ([
		"guard1" : MOB"/guard1", 
		"guard2" : MOB"/guard1"]) );
	set( "pre_exit_func", ([
		"north" : "check_guard" ]) );
	reset();	
}

int check_guard()
{
	if ( present("guard", this_object() ) ) {
		write("守衛說道: 國師有令，任何人不得進入。\n");
		return 1; }
	return 0;
}