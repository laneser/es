//#pragma save_binary

#include <mudlib.h>
#include <daemons.h>

inherit ROOM;

void create()
{
	::create();
	set_short( "任務殿堂" );
	set_long(@C_LONG
你現在正站在一間充滿著祥和氣氛的大廳之中，這個大廳是用某種白
中帶著淡藍色紋路的石材建成的，一些綠色的植物和漂亮的花卉裝飾著大
廳四周的圓柱。四面的牆壁上雕刻著極為優美的圖畫。而大廳的中央有著
一個很耀眼的水晶球(crystal ball)懸浮於空中。有一個階梯通向上方的
冒險者公會。你可以由那裡開始你的冒險旅程。
C_LONG
	);
	
	set("item_desc",([
	    "crystalball":"@@c_quests_hint",
	    "ball":"@@c_quests_hint",
	]) );
	set( "light", 1 );
	set( "exits", ([
		"up"    : "/d/adventurer/hall/adv_guild",
	    "south" : "/d/noden/farwind/area_room",
       "north" : "/d/noden/farwind/bugroom",
	]) );
	set( "pre_exit_func", ([
        "south" : "wiz_limit"
    ]) );
    set( "objects", ([
    	"explore_list" : "d/noden/farwind/items/explore_list",
   	]) );
   	reset();
}

int wiz_limit()
{
    if( !wizardp(this_player()) ) {
        	write("對不起，只有巫師才能進去。\n");
        return 1;
    }
    return 0;
}

void init()
{
     add_action("to_listen","listen");
}

string c_quests_hint()
{
   write("\n當你看著水晶球時,一種奇異的聲音傳到你的耳中...\n"
     +this_player()->query("c_name"));   
   "/std/fun/quests_hint"->show_all_quests();
   return "\n或許你應該更仔細的聆聽(listen)近一步的資料。\n";
}

int to_listen(string arg)     
{
    mixed num;
    
    if( !arg ) {
       write("你可以使用 listen ?(number) 獲得更多的資料.\n");       
       return 1;
    } else if( sscanf(arg,"%d",num) == 1 ) {
        if( num <= (int)QUEST_D->query_quests_number() )
        return "/std/fun/quests_hint"->show_quest(num); 
    }
    write("你可以使用 listen ?(number) 獲得更多的資料.\n");
    return 1;                 
}

void reset()
{
	int	i;
	object	*all_ppl;

	::reset();
	all_ppl = users();
	i = sizeof(all_ppl) - 1;
	while ( i >= 0 ) {
		call_other(	find_object_or_load("/d/noden/farwind/items/top_explore"),
					"log_player", all_ppl[i]);
		i--;
	}
}
