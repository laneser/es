#include "../island.h"
#include <mudlib.h>

inherit MONSTER;

void create()
{
        ::create();
        set_level( 18 );
        set_name( "shark", "大白鯊" );
        add( "id", ({ "shark" }) );
        set_short( "大白鯊" );
        set_long(@LONG
這鯊魚身上佈滿了傷痕，想必是與無數獵殺它的人搏鬥的痕跡，遇到它我想
還是逃好了。
LONG
        );
        set("unit","大尾");
        set_perm_stat( "str", 29 );
        set_perm_stat( "dex", 31 );
        set_perm_stat( "int", 13 );
        set_perm_stat( "kar", 28 );
        set_skill( "dodge", 100 );
        set_skill( "parry", 100);
        set( "likefish" , 1);
        set("max_hp", 550);
        set("hit_points", 550);
        set("special_defense", ([ "all":60, "none":35,"fire":35 ]) );
        set("aim_difficulty",
            ([ "vascular":66,"weakest":40 ]));
        
        set( "killer", 1 );
        set( "pursuing", 1 );
        set( "c_killer_msg","突然鯊魚迅速的由你背後遊了過來....");
        set( "alignment", -600 );
        set_natural_weapon( 70,30,60 );
        set_natural_armor( 78,30 );

        set_c_verbs( ({ "%s張開它的大口，一口向%s咬去", "%s迅速地以鼻子向%s撞去" }) );
        set_c_limbs( ({ "鰭", "身體", "尾巴" }) );
}

void die()
{
        object killer, ob;
        killer = query("last_attacker");
        if( killer->query_temp("shark_soup") )
        {
          ob = new(IOBJ"shark_wind");
          ob->move(killer);
          tell_object( killer,"你以熟練的手法將魚翅取下！\n");
          tell_room( environment(),
          killer->query("c_name")+"迅速的從屍體上割下魚翅，並小心翼翼的收進懷中！\n"
          ,killer);
        }  
        ::die();
        return;
}