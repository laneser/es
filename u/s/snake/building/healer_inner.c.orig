#include <mudlib.h>

inherit "/d/healer/building/study" ;
inherit ROOM;

void create()
{
	::create();
    set_short("Healer's inner room", "行醫者書房");
	set_long( @C_LONG_DESCRIPTION
這裡是行醫者們交換醫術心得的地方，同時也是行醫者們練習針灸的場所, 
這個房間裡最醒目的就是放在房間中央, 供經驗不足的行醫者們練習針灸的銅
人模型, 上面標示著一大堆的經脈和術語, 因為針灸是一門高難度的技巧, 若
是不能準確的下針, 往往會造成無法挽回的後果, 邢老爹特別嚴格要求門下, 
一定要在模型上練習到純熟後, 才可替人下針。
C_LONG_DESCRIPTION
	);

	set( "light", 1 );

        set( "objects", ([
                       "model" : "/d/healer/objs/model" ,
                       ]) ) ;	
	set( "exits", ([ 
		"west" : "/d/healer/building/healer_guild",
		"up" : "/d/healer/building/healer_upper",
		"south" : "/d/healer/building/healer_troom",
		"north" : "/d/healer/building/healer_reagent" 
		
		]) );

	reset();
}

