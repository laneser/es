ob_data (["long":"@@query_long","c_long.text":"這是一個留言板，專供人留言紀事。詳細用法請參看 help board。","short.text":"Thief's bulletin board","short":"@@query_short","name":"board","c_cap_name":"留言板","long.text":"這是一個留言板，專供人留言紀事。詳細用法請看 help board。","c_name":"留言板","id":({"board","bulletin board",}),"cap_name":"Board","c_short.text":"小偷留言板","silent_look":1,"last_location":0,])
messages ({(["id":1,"body":"大家好 :    小偷公會要開放測試了，所有喜歡幹壞事的人，歡迎加入小偷公會，我們沒有種族岐視，堅決相信邪惡是所有生命的本質，所以只要你喜歡為非作歹，殺人放火，歡迎加入小偷的行列。    目前小偷的進度還有一項沒完成，相信也永遠不可能做完，那就是邪惡層出不窮的詭計學，只要我們有空，會很快的開放給大家使用，目前請大家不要浪費精力在學習詭計上，因為我們還想不到任何又卑劣又惡質的詭計 ... 呵呵呵 ... 光想想就令人興奮 ...    所以啦 ! 如果你有任何整人妙計，歡迎 post 在這裡，在我們審查之後，如果有夠下流卑鄙，我們將會把它列入詭計學的教材中，並且附上你的大名，絕對讓你臭名遠播、遺臭萬年 ..    各位壞蛋們，加入小偷來幫我們測試吧 !! 讓我們一起來發揮黑社會的本質吧 !!						小小偷 茹比","title":"歡迎加入測試","time":793371875,"poster":"Ruby",]),(["id":2,"title":"< no title >","body":"hahaha 我第一個post終於搶道第一個充分發揮小偷的本能'搶' ......grin            黑暗經營者  dd (連race 都是黑的 )","time":793379722,"poster":"Dd",]),(["id":3,"body":"hahahahha..... 選 halfling la...打仗時還會 joke... 好玩ㄟ......超爆笑的小偷... 就是我啦...阿那個詭計阿.... 可不可以玩些暗渡陳倉....移花接木... 偷天換日... 口沫橫飛...","title":"< no title >","time":793385839,"poster":"Soup",]),(["id":4,"title":"脫褲大法","body":"我有一鍋idea, 叫脫褲大法, 可以在戰鬥中脫下敵人的褲頭, 使敵人為了拉褲子, 兩回合, 或一回合不能戰鬥, 這招如何呢? ccccc.....我是 BA :)","time":793446701,"poster":"Barso",]),(["id":5,"title":"??","body":"  沒有anatomlogy skill...why info commands時有aim?                                               笨笨的菜鳥巫師 stasia","time":793447366,"poster":"Stasia",]),(["id":6,"title":"詭計學","body":"詭計學--蓋布袋   利用小偷的特殊能力 hide and sneak 接近敵人  然後蓋上小偷特有的布袋...嘿嘿..  大家就一起圍毆                       女飛賊留","time":793464638,"poster":"Juice",]),(["id":7,"title":"詭計學","body":"    脫裝備啦 讓敵人混亂 集團的還會讓彼此自相殘殺棒吧！","time":793479179,"poster":"Lawse",]),(["id":8,"body":"not 'peek' ma?","title":"one of skill name 'peep'....","time":793550893,"poster":"Rogner",]),(["id":9,"body":"我覺得post 7 不錯","title":"< no title >","time":793569547,"poster":"Gy",]),(["id":10,"title":"< no title >","body":"  thief dodge 怎麼比monk 低..  感覺上飛賊啦..神偷啦..應該敏捷閃躲都高...hoho..一點看法而以...:PP","time":793606433,"poster":"Kladen",]),(["id":11,"title":"< no title >","body":"還是沒anatomlogy skills neh..還是thief's aim different from healer ?","time":793606668,"poster":"Kladen",]),(["id":12,"title":"Re: 詭計學","body":"On Thu Feb 23, Lawse w